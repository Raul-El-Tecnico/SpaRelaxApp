@page
@model SpaRelaxApp.Pages.BookingPages.DeleteModel

@{
    ViewData["Title"] = "Avboka";
}

<h1>Avboka bokning</h1>

<h3>Är du säker på att du vill avboka denna bokning?</h3>
<div>
    <h4>SpaRelaxApp.Models.Booking</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.ServiceType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Booking.ServiceType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.BookingDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Booking.BookingDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.UserId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Booking.UserId)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Booking.Id" />
        <input type="submit" value="Avboka" class="btn btn-danger" /> |
        <a asp-page="./Index">Tillbaka till mina bokningar</a>
    </form>
</div>
