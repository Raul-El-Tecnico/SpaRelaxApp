@page
@model SpaRelaxApp.Pages.BookingPages.EditModel

@{
    ViewData["Title"] = "Redigera bokning";
}

<h1>Redigera bokning</h1>

<h4>Dina bokningar</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Booking.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Booking.ServiceType" class="control-label"></label>
                <input asp-for="Booking.ServiceType" class="form-control" aria-required="true"/>
                <span asp-validation-for="Booking.ServiceType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Booking.BookingDate" class="control-label"></label>
                <input asp-for="Booking.BookingDate" class="form-control" aria-required="true"/>
                <span asp-validation-for="Booking.BookingDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Booking.UserId" class="control-label"></label>
                <input asp-for="Booking.UserId" class="form-control" />
                <span asp-validation-for="Booking.UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Spara" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Tillbaka till mina bokningar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
