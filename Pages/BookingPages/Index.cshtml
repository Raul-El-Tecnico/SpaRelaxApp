@page
@model SpaRelaxApp.Pages.BookingPages.IndexModel

@{
    ViewData["Title"] = "Mina bokningar";
}

<h1>Mina bokningar</h1>

<p>
    <a asp-page="Create">Skapa ny bokning</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].ServiceType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].BookingDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].UserId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Booking) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ServiceType)
            </td>
            <td>
                @Html.DisplayFor(model => item.BookingDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.UserId)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Redigera</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detaljer</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Avboka</a>
            </td>
        </tr>
}
    </tbody>
</table>
