@page
@model IndexModel
@{
    ViewData["Title"] = "Välkommen till Zen Spa";
}

<div class="container">
    <div class="text-center mt-5">
        <h1 class="display-4" style="color: #5d7a5d; font-weight: bold;">Lugn och Ro på Zen Spa</h1>
        <p class="lead">Upplev harmoni och avkoppling i vår lyxiga miljö.</p>

        <!-- Bild-sektion med lite mer kontroll -->
        <div class="row justify-content-center my-4">
            <div class="col-12 col-lg-10">
                <img src="~/images/spa-pool.jpg"
                     class="img-fluid rounded shadow-lg"
                     alt="Vår lyxiga spa-pool"
                     style="max-height: 500px; width: 100%; object-fit: cover;">
            </div>
        </div>

        <!-- Knapp med skugga för att sticka ut -->
        <div class="mt-4 mb-5">
            <a class="btn btn-primary btn-lg px-5 shadow" asp-page="/BookingPages/Create">Boka tid nu</a>
        </div>
    </div>

    <!-- Info-sektion med extra luft i botten (pb-5) -->
    <div class="row text-center mt-5 pb-5">
        <div class="col-md-4 mb-4">
            <h3 style="color: #5d7a5d;">Massage</h3>
            <p>Släpp på spänningar med våra professionella massörer.</p>
        </div>
        <div class="col-md-4 mb-4">
            <h3 style="color: #5d7a5d;">Relax</h3>
            <p>Njut av vår varma pool och lugna atmosfär.</p>
        </div>
        <div class="col-md-4 mb-4">
            <h3 style="color: #5d7a5d;">Behandlingar</h3>
            <p>Ge din hy ny lyster med våra ansiktsbehandlingar.</p>
        </div>
    </div>
</div>